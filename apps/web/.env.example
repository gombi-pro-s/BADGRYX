# ==============================================================================
# iCorePen — apps/web environment variables
#
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
# Never commit .env.local (it's gitignored). See MANUAL_SETUP.md for exactly
# where to get each value and how to configure it in Supabase/hosting.
# ==============================================================================

# ---- PUBLIC (safe to ship to the browser; NEXT_PUBLIC_* is inlined at build
#      time into the client bundle) ------------------------------------------

# Supabase project URL. Dashboard: Project Settings -> API -> Project URL.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon/public key. Safe to expose: every table it can reach is
# gated by Row Level Security. Dashboard: Project Settings -> API -> anon public.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The canonical URL this app is deployed at. Used to build auth email
# redirect links (confirmation, password reset). e.g. https://app.icorepen.com
# Use http://localhost:3000 for local development.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- SERVER-ONLY (never prefix with NEXT_PUBLIC_; never log these; never
#      let them reach a client bundle) ----------------------------------------

# Supabase service_role key. BYPASSES ROW LEVEL SECURITY ENTIRELY.
# Dashboard: Project Settings -> API -> service_role secret.
# Used only by apps/web/src/lib/supabase/admin.ts, guarded by `server-only`.
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic API key for the AI Security Mentor / AI-assisted scanning
# reasoning layer. Not yet wired into any code path in this phase of the
# build -- reserved for when that feature lands. console.anthropic.com -> API Keys.
ANTHROPIC_API_KEY=
