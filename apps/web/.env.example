# ==============================================================================
# iCorePen — apps/web environment variables
#
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
# Never commit .env.local (it's gitignored). See MANUAL_SETUP.md for exactly
# where to get each value and how to configure it in Supabase/hosting.
# ==============================================================================

# ---- PUBLIC (safe to ship to the browser; NEXT_PUBLIC_* is inlined at build
#      time into the client bundle) ------------------------------------------

# Supabase project URL. Dashboard: Project Settings -> API -> Project URL.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon/public key. Safe to expose: every table it can reach is
# gated by Row Level Security. Dashboard: Project Settings -> API -> anon public.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The canonical URL this app is deployed at. Used to build auth email
# redirect links (confirmation, password reset). e.g. https://app.icorepen.com
# Use http://localhost:3000 for local development.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- SERVER-ONLY (never prefix with NEXT_PUBLIC_; never log these; never
#      let them reach a client bundle) ----------------------------------------

# Supabase service_role key. BYPASSES ROW LEVEL SECURITY ENTIRELY.
# Dashboard: Project Settings -> API -> service_role secret.
# Used only by apps/web/src/lib/supabase/admin.ts, guarded by `server-only`.
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic API key for the AI Security Mentor / AI-assisted scanning
# reasoning layer. Not yet wired into any code path in this phase of the
# build -- reserved for when that feature lands. console.anthropic.com -> API Keys.
ANTHROPIC_API_KEY=

# ---- Live billing (optional -- see docs/adr/0011-live-billing-integration.md
#      and MANUAL_SETUP.md §4). Every checkout/webhook code path is real and
#      complete; without these set, /settings/billing shows each provider's
#      upgrade button as "not configured" instead of crashing, and its
#      webhook route returns 503. Configure as many or as few providers as
#      you want to accept -- each is fully independent. ------------------

# Stripe. Dashboard: developers.stripe.com/apikeys (secret key),
# developers.stripe.com/webhooks (webhook signing secret after you register
# https://<your-site>/api/billing/webhook/stripe), and the Price you create
# for the Pro plan's Product (price ID, not product ID).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO=

# Paystack. Dashboard: dashboard.paystack.com/#/settings/developer (secret
# key -- also used to verify webhook signatures, there is no separate
# webhook secret), dashboard.paystack.com/#/plans (create a Pro plan, copy
# its plan code). Webhook URL: https://<your-site>/api/billing/webhook/paystack
PAYSTACK_SECRET_KEY=
PAYSTACK_PLAN_CODE_PRO=

# Flutterwave. Dashboard: dashboard.flutterwave.com/settings/apis (secret
# key), dashboard.flutterwave.com/settings/webhooks (set a "Secret Hash" --
# NOT an HMAC secret, a literal string Flutterwave echoes back on every
# webhook call -- and register https://<your-site>/api/billing/webhook/flutterwave),
# dashboard.flutterwave.com/dashboard/payment-plans (create a Pro payment
# plan, copy its ID).
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET_HASH=
FLUTTERWAVE_PAYMENT_PLAN_ID_PRO=
